      },
      "alt": "Screen recording of the scene graph being built while the drone flies the ITC second floor loop. The graph grows from nothing to a full corridor circuit, with live RGB, semantic, and depth views alongside.",
      "caption": "The scene graph forming over one loop of the ITC second floor, from the first frame to loop closure. Playback is 10x real time. Live RGB, predicted semantics, and predicted depth run down the right.",
      "credit": "Mono-Hydra with M2H",
      "clickToLoad": false
    },
    "icra26": {
      "digest": "6447de3dadac1cb5",
      "width": 1600,
      "height": 686,
      "mp4": "/media/video/icra26.mp4",
      "webm": null,
      "poster": "/media/video/icra26-poster.jpg",
      "preview": "/media/video/icra26-preview.mp4",
      "bytes": {
        "icra26.mp4": 1659513,
        "icra26-poster.jpg": 74732,
        "icra26-preview.mp4": 229950
      },
      "alt": "Screen recording of ScanNet scene 0000. A hierarchical 3D scene graph hangs from a building node down through room and place nodes to labelled object boxes over the reconstructed mesh, while the RGB frame, the predicted semantics, and the predicted depth run down the right.",
      "caption": "The whole pipeline on ScanNet scene 0000. M2H-MX predicts depth and semantics from the image stream, Mono-Hydra++ consumes those predictions inside the visual-inertial odometry and the mapping backend, and the hierarchical scene graph is built in real time. Playback is 16x.",
      "credit": "M2H-MX",
      "clickToLoad": false
    },
    "scope-explorer": {
      "digest": "9c436c9be993137e",
      "width": 1100,
      "height": 892,
