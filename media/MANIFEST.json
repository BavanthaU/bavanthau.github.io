      "bytes": {
        "scope-explorer.mp4": 1743390,
        "scope-explorer-poster.jpg": 65369,
        "scope-explorer-preview.mp4": 458285
      },
      "alt": "Simulated indoor exploration run showing the robot's occupancy map growing as it selects routes through the environment.",
      "caption": "Autonomous exploration in simulation. The robot holds an occupancy map it has built itself and commits to one certified route at a time, so the map fills in region by region rather than by wandering. 60 second excerpt.",
      "credit": "Exploration work in progress",
      "clickToLoad": false
    },
